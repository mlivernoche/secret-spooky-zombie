{
    "name": "React baseline",
    "image": "mcr.microsoft.com/devcontainers/javascript-node:24-bookworm",
    "features": {
        "ghcr.io/nolanjx/devcontainer-features/codex:1": {},
        "ghcr.io/devcontainers/features/docker-in-docker:4": {},
        "ghcr.io/devcontainers/features/common-utils:2": {}
    },
    "remoteUser": "node",
    "updateRemoteUserUID": true,
    "init": true,
    "remoteEnv": {
        "VP_HOME": "/home/node/.vite-plus",
        "NPM_CONFIG_PREFIX": "/home/node/.local",
        "PATH": "/home/node/.local/bin:/home/node/.vite-plus/bin:${containerEnv:PATH}"
    },
    "forwardPorts": [
        5173,
        4173
    ],
    "portsAttributes": {
        "5173": {
            "label": "Vite development",
            "onAutoForward": "notify"
        },
        "4173": {
            "label": "Vite preview",
            "onAutoForward": "notify"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "EditorConfig.EditorConfig",
                "VoidZero.vite-plus-extension-pack",
                "oxc.oxc-vscode",
                "openai.chatgpt",
                "bradlc.vscode-tailwindcss",
                "TypeScriptTeam.native-preview"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash",
                "files.eol": "\n",
                "[json]": {
                    "editor.defaultFormatter": "vscode.json-language-features"
                },
                "[jsonc]": {
                    "editor.defaultFormatter": "vscode.json-language-features"
                },
                "[javascript]": {
                    "editor.defaultFormatter": "oxc.oxc-vscode"
                },
                "[javascriptreact]": {
                    "editor.defaultFormatter": "oxc.oxc-vscode"
                },
                "[typescript]": {
                    "editor.defaultFormatter": "oxc.oxc-vscode"
                },
                "[typescriptreact]": {
                    "editor.defaultFormatter": "oxc.oxc-vscode"
                },
                "oxc.fmt.configPath": "./vite.config.ts",
                "editor.formatOnSave": true,
                "editor.formatOnSaveMode": "file",
                "editor.codeActionsOnSave": {
                    "source.fixAll.oxc": "explicit"
                },
                "js/ts.experimental.useTsgo": true,
                "js/ts.tsdk.path": "/home/node/.local/lib/node_modules/tsrs/tsdk"
            }
        }
    },
    "postCreateCommand": [
        "bash",
        "-c",
        "set -euo pipefail\nsudo apt-get update\nsudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends git openssh-client ca-certificates curl wget jq ripgrep fd-find fzf bat tree less nano htop tmux zip unzip xz-utils file lsof procps iproute2 dnsutils netcat-openbsd build-essential python3 pkg-config\nmkdir -p \"$HOME/.local/bin\"\nln -sf /usr/bin/fdfind \"$HOME/.local/bin/fd\"\nln -sf /usr/bin/batcat \"$HOME/.local/bin/bat\"\nnpm install --global --prefix \"$HOME/.local\" pnpm@12 tsrs@0.20.1-ts7.1.0-beta\ninstaller_path=\"$(mktemp)\"\ntrap 'rm -f \"$installer_path\"' EXIT\ncurl --fail --silent --show-error --location https://vite.plus --output \"$installer_path\"\nCI=1 VP_NODE_MANAGER=no VP_PM_MANAGER=no bash \"$installer_path\"\n\"$VP_HOME/bin/vp\" env off\nnode --version\n\"$HOME/.local/bin/pnpm\" --version\n\"$VP_HOME/bin/vp\" --version\n\"$HOME/.local/bin/tsrs\" --version\n"
    ],
    "waitFor": "postCreateCommand"
}